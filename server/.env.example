# Contraseña de acceso. Si está vacía, la app no pide contraseña (uso local).
APP_PASSWORD=

# Base de datos para el portafolio (https://upstash.com, plan gratuito).
# Si no se configuran, el portafolio se guarda en server/data/portfolio.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional y gratis: resúmenes de noticias con IA usando Groq (https://console.groq.com).
GROQ_API_KEY=
# Modelo de Groq (por defecto openai/gpt-oss-120b; openai/gpt-oss-20b es más rápido).
GROQ_MODEL=

# Opcional: botón "Sincronizar eToro" (solo lectura de posiciones).
# Se crean en eToro > Configuración > Trading > Gestión de claves de API.
ETORO_API_KEY=
ETORO_USER_KEY=

# Opcional: identificación ante SEC EDGAR (piden un nombre y un email de contacto).
SEC_USER_AGENT=

PORT=3001
