# Contraseña de acceso. Si está vacía, la app no pide contraseña (uso local).
APP_PASSWORD=

# Base de datos para el portafolio (https://upstash.com, plan gratuito).
# Si no se configuran, el portafolio se guarda en server/data/portfolio.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: habilita resúmenes de noticias y "Resumen del día" generados con Claude.
# Sin clave, la app muestra un resumen extraído de las primeras líneas del artículo.
ANTHROPIC_API_KEY=

PORT=3001
